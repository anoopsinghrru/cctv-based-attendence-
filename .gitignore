# Note: git does not allow a comment on the same line as a pattern.

# ---------------------------------------------------------------------------
# Personal and biometric data - never commit
# ---------------------------------------------------------------------------
# enrolled face photos
data/faces/
# students, face embeddings and attendance records (plus SQLite journal files)
data/attendance.db
data/attendance.db-*
# the real class list - a template is in data/students.example.csv
data/students.csv
# may hold RTSP addresses with passwords - a template is in data/cameras.example.csv
data/cameras.csv
# reports, face snapshots, annotated videos, uploads, generated figures
outputs/

# ---------------------------------------------------------------------------
# Large downloads - fetched or generated, see README
# ---------------------------------------------------------------------------
# det_10g.onnx and w600k_r50.onnx (InsightFace buffalo_l)
models/
*.onnx
# datasets and sample videos
data/samples/
# ffmpeg binary copied for yt-dlp
tools/
# video files anywhere
*.mp4
*.avi
*.mov
*.mkv
*.webm

